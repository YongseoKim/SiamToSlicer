<Window x:Class="SiamToSlicerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SiamToSlicerApp"
        mc:Ignorable="d"
        Title="SiamToSlicerApp" Height="450" Width="800">
    <Grid>
        <Button x:Name="DicomButton" Content="DICOM file" FontSize="10" HorizontalAlignment="Left" Height="35" Margin="61,109,0,0" VerticalAlignment="Top" Width="95" Click="DicomButton_Click"/>
        <TextBox x:Name="DicomPathTextBox" HorizontalAlignment="Left" Height="35" Margin="186,109,0,0" VerticalAlignment="Top" Width="550" IsReadOnly="True" VerticalContentAlignment="Center"/>
        <Button x:Name="InferenceButton" Content="Inference" FontSize="10" HorizontalAlignment="Left" Height="35" Margin="61,183,0,0" VerticalAlignment="Top" Width="95" Click="InferenceButton_Click"/>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" Height="1" Margin="0,239,0,0" VerticalAlignment="Top" Width="800"/>
        <Label Content="Upload DICOM file" FontSize="14" HorizontalAlignment="Left" Margin="52,75,0,0" VerticalAlignment="Top" Width="138"/>
        <Label Content="Inference DICOM" FontSize="14" HorizontalAlignment="Left" Margin="52,149,0,0" VerticalAlignment="Top"/>
        <Label Content="Concole" FontSize="16" HorizontalAlignment="Left" Margin="52,246,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="LogTextBox" HorizontalAlignment="Left" Height="70" Margin="61,282,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="675" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        <Label Content="Siam to Slicer Wizard" FontSize="25" HorizontalAlignment="Left" Margin="49,27,0,0" VerticalAlignment="Top"/>
        <Button x:Name="OpenSlicerButton" Content="Slice Viewers" HorizontalAlignment="Left" Height="38" Margin="461,368,0,0" VerticalAlignment="Top" Width="114" Click="OpenSlicerButton_Click" IsEnabled="False"/>
        <Button x:Name="OpenVolumeButton" Content="3D Rendering" HorizontalAlignment="Left" Height="38" Margin="600,368,0,0" VerticalAlignment="Top" Width="110" Click="OpenVolumeButton_Click" IsEnabled="False"/>

    </Grid>
</Window>
